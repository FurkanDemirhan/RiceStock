{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": [
        "power-profiles-daemon","battery", "network"
    ],

    "modules-center": [
	"hyprland/window"
    ],

    "modules-right": [
        "backlight",
	"cpu",
        "memory"
        
        
	
    ],

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%I : %M : %S %p %t %A, %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
	"interval": 1,
        "calendar": {
		"mode"		: "year",
		"mode-mon-col"	: 3,
		"weeks-pos"	: "right",
		"format": {   
                     "months":     "<span color='#f24d37'><b>{}</b></span>",
                     "days":       "<span color='#CbCfaA'><b>{}</b></span>",
                     "weeks":      "<span color='#dFf0aa'><b>W{}</b></span>",
                     "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                     "today":      "<span color='#fFc029'><b><u>{}</u></b></span>"
                }
	}
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,

        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 2,

        "states": {
            "critical": 80
        }
    },

    "battery": {
        "format": "{capacity}% ↓ {time}",
	"format-charging": "{capacity}% ↑",
	"format-plugged": "{capacity}% ",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "network": {
        "format-wifi" : "wifi {bandwidthDownBits}",
        "format-ethernet": "enth {bandwidthDownBits}",
        "format-disconnected" : "no network",
        "interval": 1,
        "tooltip": false
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "vol {volume}%",
        "format-bluetooth": "vol {volume}%",
        "nospacing": 1,
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "power-profiles-daemon": {
        "format": "{icon}   {profile}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "P",
            "performance": "P",
            "balanced": "B",
            "power-saver": "PS"
        }
     },
        "backlight": {
        "format": "bright {percent}%"
    },
    

    "hyprland/window": {
	"format": "[ {title} ]",
	"seperate-outputs": true
    },

    "pulseaudio/slider": {
	"min": 0,
	"max": 100,
	"orientation": "horizontal"
    }
}
